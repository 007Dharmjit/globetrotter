# Copy this file to backend/.env and set DATABASE_URL and SECRET_KEY.

# Must end in the database name you created with `createdb`.
# Use whichever of these connects on your machine:
#   Linux, over the local socket:
#     postgresql://YOUR_USERNAME@/globetrotter?host=/var/run/postgresql
#   macOS (Homebrew), over TCP:
#     postgresql://YOUR_USERNAME@localhost:5432/globetrotter
#   Any machine, with a role that has a password:
#     postgresql://USER:PASSWORD@localhost:5432/globetrotter
DATABASE_URL=

# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# How long a login stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Where the frontend runs. Used for CORS and for the address written into
# share links, so it must match the URL you open in the browser.
FRONTEND_ORIGIN=http://localhost:5173
